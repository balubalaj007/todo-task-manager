* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #0f172a;
  background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px 18px;
}

.todo-card {
  width: min(1100px, 100%);
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 28px;
  box-shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
  overflow: hidden;
  backdrop-filter: blur(8px);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  border-bottom: 1px solid #e2e8f0;
  padding: 18px 22px;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.4rem, 2vw, 2rem);
  letter-spacing: -0.04em;
}

.nav-button {
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 12px;
  background: #e2e8f0;
  color: #0f172a;
  font-size: 1.8rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.18s ease, background 0.18s ease;
}

.nav-button:hover {
  background: #dfe7ff;
  transform: translateY(-1px);
}

.weekday-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.weekday-row {
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.weekday-name {
  padding: 14px 12px;
  text-align: center;
  font-weight: 700;
  color: #475569;
  font-size: 0.88rem;
}

.calendar-grid {
  background: #fff;
}

.day-box {
  min-height: 120px;
  border: 1px solid #eef2f7;
  background: #fff;
  text-align: left;
  padding: 12px 10px;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.day-box:hover {
  background: #f8fafc;
  transform: translateY(-1px);
}

.day-box.selected {
  background: #eef2ff;
  box-shadow: inset 0 0 0 2px #818cf8;
}

.day-box.today {
  background: #f0fdf4;
}

.day-box.empty {
  background: #f8fafc;
  cursor: default;
}

.day-number {
  display: inline-flex;
  width: 32px;
  height: 32px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 700;
}

.mini-task-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.mini-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #c7d2fe;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);
}

.mini-dot.done {
  background: #22c55e;
}

.details-panel {
  background: #fff;
  padding: 24px 22px 30px;
}

.detail-header h2 {
  margin: 0 0 18px;
  font-size: clamp(1.2rem, 1.8vw, 1.8rem);
}

.task-entry {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.task-entry input {
  flex: 1;
  min-width: 0;
  padding: 14px 16px;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  outline: none;
  background: #fff;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.task-entry input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
}

.primary-button {
  border: none;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: white;
  border-radius: 12px;
  padding: 0 20px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 12px 24px rgba(99, 102, 241, 0.22);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  border-radius: 14px;
  padding: 12px 14px;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.task-item.done {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.check-button {
  width: 26px;
  height: 26px;
  border: 2px solid #4f46e5;
  background: transparent;
  color: #4f46e5;
  border-radius: 999px;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.task-text {
  flex: 1;
  min-width: 0;
  font-size: 1rem;
  word-break: break-word;
}

.task-item.done .task-text {
  text-decoration: line-through;
  color: #64748b;
}

.delete-button {
  border: none;
  background: transparent;
  color: #ef4444;
  font-size: 1.6rem;
  line-height: 1;
  padding: 0 2px;
  cursor: pointer;
}

.empty-state {
  margin: 0;
  padding: 18px 10px;
  text-align: center;
  color: #64748b;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  background: #f8fafc;
}

@media (max-width: 720px) {
  .todo-card {
    border-radius: 20px;
  }

  .day-box {
    min-height: 92px;
  }

  .task-entry {
    flex-direction: column;
  }

  .primary-button {
    min-height: 48px;
  }
}
